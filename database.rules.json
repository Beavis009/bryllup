{
  "rules": {
    "questions": {
      ".read": true,
      ".write": false
    },
    "activeQuestion": {
      ".read": true,
      ".write": "newData.exists()",
      ".validate": "newData.hasChildren(['questionId', 'activatedAt', 'activatedAtClient'])",
      "questionId": {
        ".validate": "newData.isString() && newData.val().matches(/^q([1-9]|1[0-2])$/)"
      },
      "activatedAt": {
        ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
      },
      "activatedAtClient": {
        ".validate": "newData.isString() && newData.val().length <= 40"
      },
      "$other": {
        ".validate": false
      }
    },
    "participants": {
      ".read": true,
      "$participantId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'createdAt', 'createdAtClient', 'pageUrl'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
        },
        "createdAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "pageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "submissions": {
      ".read": true,
      "$submissionId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['participantId', 'name', 'questionId', 'question', 'answer', 'createdAt', 'createdAtClient', 'pageUrl'])",
        "participantId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "questionId": {
          ".validate": "newData.isString() && newData.val().matches(/^q([1-9]|1[0-2])$/)"
        },
        "question": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
        },
        "answer": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
        },
        "createdAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "pageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "winners": {
      ".read": true,
      "$questionId": {
        ".write": "newData.exists() && $questionId.matches(/^q([1-9]|1[0-2])$/)",
        ".validate": "newData.hasChildren(['questionId', 'question', 'submissionId', 'winnerName', 'answer', 'savedAt', 'savedAtClient'])",
        "questionId": {
          ".validate": "newData.isString() && newData.val() == $questionId"
        },
        "question": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
        },
        "submissionId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "winnerName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "answer": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "savedAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
        },
        "savedAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
