{
  "rules": {
    "questions": {
      ".read": true,
      "$questionId": {
        "type": {
          ".write": "$questionId.matches(/^q(0|[1-9]|1[0-2])$/) && newData.exists()",
          ".validate": "newData.isString() && (newData.val() == 'number' || newData.val() == 'time')"
        }
      }
    },
    "activeQuestion": {
      ".read": true,
      ".write": "newData.exists()",
      ".validate": "newData.hasChildren(['questionId', 'activatedAt', 'activatedAtClient'])",
      "questionId": {
        ".validate": "newData.isString() && newData.val().matches(/^q(0|[1-9]|1[0-2])$/)"
      },
      "activatedAt": {
        ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
      },
      "activatedAtClient": {
        ".validate": "newData.isString() && newData.val().length <= 40"
      },
      "$other": {
        ".validate": false
      }
    },
    "participants": {
      ".read": true,
      "$participantId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'createdAt', 'createdAtClient', 'pageUrl'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
        },
        "createdAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "pageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "answers": {
      ".read": true,
      "$questionId": {
        "$participantId": {
          ".write": "!data.exists() && newData.exists() && $questionId.matches(/^q(0|[1-9]|1[0-2])$/)",
          ".validate": "newData.hasChildren(['participantId', 'name', 'questionId', 'question', 'answer', 'answerType', 'answerValue', 'createdAt', 'createdAtClient', 'pageUrl'])",
          "participantId": {
            ".validate": "newData.isString() && newData.val() == $participantId && newData.val().length > 0 && newData.val().length <= 120"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "questionId": {
            ".validate": "newData.isString() && newData.val() == $questionId && newData.val().matches(/^q(0|[1-9]|1[0-2])$/)"
          },
          "question": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
          },
          "answer": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "answerType": {
            ".validate": "newData.isString() && (newData.val() == 'number' || newData.val() == 'time')"
          },
          "answerValue": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
          },
          "createdAtClient": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "pageUrl": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "submissions": {
      ".read": true,
      "$submissionId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['participantId', 'name', 'questionId', 'question', 'answer', 'createdAt', 'createdAtClient', 'pageUrl'])",
        "participantId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "questionId": {
          ".validate": "newData.isString() && newData.val().matches(/^q(0|[1-9]|1[0-2])$/)"
        },
        "question": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
        },
        "answer": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
        },
        "createdAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "pageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "winners": {
      ".read": true,
      "$questionId": {
        ".write": "newData.exists() && $questionId.matches(/^q(0|[1-9]|1[0-2])$/)",
        ".validate": "newData.hasChildren(['questionId', 'question', 'questionCategory', 'questionType', 'correctAnswer', 'correctAnswerValue', 'submissionId', 'participantId', 'winnerName', 'answer', 'answerType', 'answerValue', 'distance', 'answeredAt', 'answeredAtClient', 'savedAt', 'savedAtClient'])",
        "questionId": {
          ".validate": "newData.isString() && newData.val() == $questionId"
        },
        "question": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
        },
        "questionCategory": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "questionType": {
          ".validate": "newData.isString() && (newData.val() == 'number' || newData.val() == 'time')"
        },
        "correctAnswer": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "correctAnswerValue": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
        },
        "submissionId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "participantId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "winnerName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "answer": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "answerType": {
          ".validate": "newData.isString() && (newData.val() == 'number' || newData.val() == 'time')"
        },
        "answerValue": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
        },
        "distance": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
        },
        "answeredAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 1000"
        },
        "answeredAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "savedAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
        },
        "savedAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "questionVideos": {
      ".read": true,
      "$questionId": {
        ".write": "newData.exists() && $questionId.matches(/^q(0|[1-9]|1[0-2])$/)",
        ".validate": "newData.hasChildren(['questionId', 'question', 'questionCategory', 'url', 'embedUrl', 'provider', 'storagePath', 'fileName', 'contentType', 'size', 'visible', 'updatedAt', 'updatedAtClient']) && newData.child('url').val() == newData.child('embedUrl').val()",
        "questionId": {
          ".validate": "newData.isString() && newData.val() == $questionId"
        },
        "question": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
        },
        "questionCategory": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "url": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/firebasestorage\\.googleapis\\.com\\/.+$/) && newData.val().length <= 1000"
        },
        "embedUrl": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/firebasestorage\\.googleapis\\.com\\/.+$/) && newData.val().length <= 1000"
        },
        "provider": {
          ".validate": "newData.isString() && newData.val() == 'file'"
        },
        "storagePath": {
          ".validate": "newData.isString() && newData.val().matches(/^questionVideos\\/q(0|[1-9]|1[0-2])\\/.+$/) && newData.val().length <= 500"
        },
        "fileName": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "contentType": {
          ".validate": "newData.isString() && newData.val().matches(/^video\\/.+$/) && newData.val().length <= 100"
        },
        "size": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 524288000"
        },
        "visible": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 1000"
        },
        "updatedAtClient": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
